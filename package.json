    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.0",
    "@types/express": "^4.21.1",
    "nodemon": "^3.1.7",
    "typescript": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.2.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
