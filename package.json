{
  "name": "my-gastronomy-backend",
  "version": "1.0.0",
  "description": "A MyGastronomy backend API built with TypeScript and MongoDB",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm --loader tsconfig-paths/register src/index.ts",
    "dev:nodemon": "nodemon --watch 'src/**/*.ts' --exec 'node --loader ts-node/esm --loader tsconfig-paths/register src/index.ts'",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/mongodb": "^4.0.1",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
