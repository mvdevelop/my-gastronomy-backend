  "description": "A MyGastronomy backend API built with TypeScript and MongoDB",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm --loader tsconfig-paths/register src/index.ts",
    "dev:nodemon": "nodemon --watch 'src/**/*.ts' --exec 'node --loader ts-node/esm --loader tsconfig-paths/register src/index.ts'",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/jsonwebtoken": "^9.0.0",
