# MongoDB
MONGO_CS=mongodb://localhost:27017/mygastronomy
MONGO_DB_NAME=mygastronomy

# Server
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=change-me-to-a-real-secret

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT=100

# Logging
LOG_LEVEL=info

# Body Parser
BODY_LIMIT=1mb
