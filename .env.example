# MongoDB Connection String
MONGO_CS=mongodb://localhost:27017/yourdatabase

# Database Name
MONGO_DB_NAME=mygastronomy

# JWT Secret Key
JWT_SECRET=your-secret-key-here

# Server Port (optional, defaults to 3000)
PORT=3000

# CORS Origin (optional, defaults to all origins)
CORS_ORIGIN=*

# Node Environment (optional, defaults to development)
NODE_ENV=development

# Application Name
APP_NAME=MyGastronomy API

# Application Version
APP_VERSION=1.0.0

# Log Level
LOG_LEVEL=info

# Rate Limiting (requests per minute)
RATE_LIMIT=100

# Request Timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# Body Parser Limit
BODY_LIMIT=10mb

# Upload Directory
UPLOAD_DIR=uploads/

# Static File Path
STATIC_PATH=public/

# API Base Path
API_BASE_PATH=/api

# Enable/Disable Features
ENABLE_AUTH=true
ENABLE_SWAGGER=false

# Security Headers
SECURITY_HEADERS=true

# Cross Origin Resource Sharing
CORS_CREDENTIALS=false

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=3600000

# Email Configuration (for future use)
EMAIL_SERVICE=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Redis Configuration (if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=optional

# AWS Configuration (if using AWS services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Google OAuth (if using Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (if using Facebook authentication)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Twitter OAuth (if using Twitter authentication)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret

# LinkedIn OAuth (if using LinkedIn authentication)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret